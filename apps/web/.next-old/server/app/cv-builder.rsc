23:Tb34,[{"@context":"https://schema.org","@type":"WebApplication","name":"DdotsMediaJobs ATS CV Builder","applicationCategory":"BusinessApplication","operatingSystem":"Web","url":"https://ddotsmediajobs.com/cv-builder","offers":{"@type":"Offer","price":"0","priceCurrency":"AED"}},{"@context":"https://schema.org","@type":"HowTo","name":"10 ATS Tips for UAE Job Applications","step":[{"@type":"HowToStep","position":1,"name":"Use standard section headings","text":"Stick to “Work Experience”, “Education”, “Skills” — ATS parsers look for these exact labels."},{"@type":"HowToStep","position":2,"name":"Avoid tables and columns","text":"Multi-column layouts and tables confuse parsers and scramble your data."},{"@type":"HowToStep","position":3,"name":"Include keywords from the job description","text":"Mirror the exact skills and titles the employer lists."},{"@type":"HowToStep","position":4,"name":"Use standard fonts (Arial, Calibri)","text":"Decorative fonts may not render or parse correctly."},{"@type":"HowToStep","position":5,"name":"Save as PDF, not Word","text":"PDF preserves layout and is widely ATS-compatible."},{"@type":"HowToStep","position":6,"name":"Include UAE phone format (+971)","text":"Use the full international format so recruiters can reach you."},{"@type":"HowToStep","position":7,"name":"Add your LinkedIn profile URL","text":"A complete profile builds trust and adds keywords."},{"@type":"HowToStep","position":8,"name":"Quantify achievements with numbers","text":"“Increased sales 30%” beats “responsible for sales”."},{"@type":"HowToStep","position":9,"name":"Keep to 1-2 pages max","text":"UAE recruiters skim — be concise and relevant."},{"@type":"HowToStep","position":10,"name":"Use active verbs (Managed, Led, Achieved)","text":"Strong verbs signal impact and ownership."}]},{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is this CV builder free?","acceptedAnswer":{"@type":"Answer","text":"Yes, completely free for all jobseekers on DdotsMediaJobs."}},{"@type":"Question","name":"Will my CV pass ATS systems?","acceptedAnswer":{"@type":"Answer","text":"Our templates are specifically designed to pass ATS used by UAE employers."}},{"@type":"Question","name":"Can I create an Arabic CV?","acceptedAnswer":{"@type":"Answer","text":"Yes, our CV builder supports Arabic with proper RTL formatting."}},{"@type":"Question","name":"How long should a UAE CV be?","acceptedAnswer":{"@type":"Answer","text":"1-2 pages is ideal for UAE employers."}},{"@type":"Question","name":"What format should I save my CV?","acceptedAnswer":{"@type":"Answer","text":"PDF is recommended for ATS compatibility."}},{"@type":"Question","name":"Can I use this for jobs outside UAE?","acceptedAnswer":{"@type":"Answer","text":"Yes, our templates work for GCC and international applications."}}]}]1a:["$","$1","c",{"children":[["$","div",null,{"className":"bg-white","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$23"}}],["$","section",null,{"className":"bg-navy-900 text-white","children":["$","div",null,{"className":"mx-auto max-w-4xl px-4 py-16 text-center md:py-20","children":[["$","h1",null,{"className":"font-display text-3xl font-extrabold leading-tight sm:text-4xl md:text-5xl","children":"Build an ATS-Optimized CV for UAE Jobs — Free"}],"$L24","$L25","$L26"]}]}],"$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e"]}],null,"$L2f"]}]
