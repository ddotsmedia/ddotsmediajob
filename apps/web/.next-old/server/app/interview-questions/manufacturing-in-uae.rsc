3c:["$","li","Do you have any questions for us?",{"className":"rounded-xl border bg-white p-5","children":[["$","h2",null,{"className":"font-display text-base font-bold text-navy-900","children":[["$","span",null,{"className":"text-teal-600","children":[19,"."]}]," ","Do you have any questions for us?"]}],["$","p",null,{"className":"mt-2 text-sm text-navy-700/75","children":"Always say yes. Ask about team structure, success metrics for the role, growth path, or the package details (visa, insurance, allowances). It signals genuine interest."}]]}]
